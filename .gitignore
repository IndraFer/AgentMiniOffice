# Local knowledge base and reference material. Never public.
.memorypedia/
REFERENCES/
memorypedia/

# Runtime data produced by the collector
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.join-secret

# Secrets
.env
.env.*
!.env.example

# Dependencies and build output
.ruff_cache
__pycache__/
node_modules/
dist/
build/

# Logs
logs/
*.log
npm-debug.log*

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Agent harness state
.agent*/
.pi*/
.claude*/
.codex*/

# Note: documentation under docs/ is intentionally NOT ignored.
# Public artifacts must stay committed: docs/*.md, docs/*.sql, Dockerfile, docker-compose.yml.

# Generated by `bun run vendor:three`, only needed for offline installs
public/vendor/

# npm is not the canonical installer here, bun is
package-lock.json
