{
  "name": "agentminioffice",
  "version": "0.3.1",
  "type": "module",
  "description": "A small self-hosted office where you watch your AI agents work.",
  "author": "IndraFer - KoiN Codeveloper",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "dev:node": "tsx watch src/index.ts",
    "start:node": "tsx src/index.ts",
    "test": "bun test",
    "test:node": "tsx tests/smoke.node.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check src/ tests/ scripts/ public/ --diagnostic-level=error",
    "format": "bunx biome check --write src/ tests/ scripts/ public/",
    "admin": "bun scripts/admin.ts",
    "admin:node": "tsx scripts/admin.ts",
    "check:latest": "bun scripts/check-latest.ts",
    "vendor:three": "bun scripts/vendor-three.ts",
    "demo": "bun scripts/demo.ts",
    "demo:node": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
