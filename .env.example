# Copy to .env. Both runtimes load it explicitly, so behaviour is identical.

# Bind to loopback only. Put Caddy or nginx in front for TLS.
MINIOFFICE_HOST=127.0.0.1
MINIOFFICE_PORT=3000

# API request diagnostics: timestamp, method, route template, HTTP status and duration.
MINIOFFICE_REQUEST_LOG=1

# Runtime data. Created on first boot if missing.
MINIOFFICE_DATA_DIR=./data
MINIOFFICE_DB_FILE=./data/minioffice.db

# Schema file applied on every boot. Safe to re-run, it is idempotent.
MINIOFFICE_SCHEMA=./docs/SCHEMA.sql

# Presence thresholds in milliseconds.
MINIOFFICE_ONLINE_MS=30000
MINIOFFICE_STALE_MS=90000

# Minutes AFTER a session goes offline. The next valid heartbeat in its office runs cleanup.
MINIOFFICE_RETENTION_MINUTES=30
# Dedicated fixed-token workers keep their grant, not their old tasks or session activity.
MINIOFFICE_DEDICATED_RETENTION_MINUTES=1440

# How often in-memory presence is flushed to SQLite.
MINIOFFICE_FLUSH_MS=5000

# Minimum time a room stays visible before it may change again.
MINIOFFICE_ROOM_HYSTERESIS_MS=2000

# Seconds a task lease stays valid before the sweeper returns it to pending.
MINIOFFICE_LEASE_SECONDS=60

# How often expired leases are swept.
MINIOFFICE_LEASE_SWEEP_MS=5000

# How long a dashboard login stays valid, in days.
MINIOFFICE_SESSION_TTL_DAYS=30

# Set to 1 behind TLS so the session cookie is only sent over https.
MINIOFFICE_SECURE_COOKIES=0

# Allow self sign up from the dashboard. Off by default: a public panel with open registration is
# a spam target, and there is no moderation surface yet.
MINIOFFICE_ALLOW_REGISTRATION=0

# Anonymous office viewing is managed by the Owner in Dashboard → Office Access → Share Office.
